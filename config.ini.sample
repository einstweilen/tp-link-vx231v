[Router]
# IP-Adresse oder Hostname des Routers
routerip = 192.168.0.1

[Database]
# Name der SQLite Datenbank für Log- und Statistikdaten
db_name = router_data.db
# Name der Sprachdatenbank für Übersetzungen im Dashboard/Report
lang_db_name = router_lang.db

[Telnet]
# Benutzername für den Telnet-Login am Router (oft 'admin' oder 'root')
username = DEIN_TELNET_BENUTZER
# Passwort für den Telnet-Login
password = DEIN_TELNET_PASSWORT

[SNMP]
# SNMP v3 (USM) - Zugangsdaten des am Router angelegten SNMP-Benutzers
# Benutzername (frei wählbar, muss exakt dem Routerwert entsprechen)
snmpuser = DEIN_SNMP_BENUTZER
# Authentifizierungs-Passwort (muss exakt dem Routerwert entsprechen)
snmppass = DEIN_SNMP_PASSWORT
# Authentifizierungsprotokoll: MD5 oder SHA (Voreinstellung: MD5)
#snmpauth = MD5
# Sicherheitsstufe: authNoPriv, noAuthNoPriv oder authPriv (Voreinstellung: authNoPriv)
#snmplevel = authNoPriv
# Nur bei snmplevel = authPriv erforderlich (sonst "ohne Privacy"):
# Privacy-Passwort und Privacy-Protokoll: DES oder AES (Voreinstellung: DES)
#snmppriv = DEIN_SNMP_PRIVACY_PASSWORT
#snmpprivproto = DES
#
# Hinweis: Das Passwort steht in der Prozessliste (ps). Sicherer ist eine
# Datei ~/.snmp/snmp.conf mit defSecurityName, defAuthType, defAuthPassphrase
# und defSecurityLevel - die Passphrase steht dann nicht auf der Kommandozeile.

[GUI]
# Benutzername für das Web-Interface des Routers
username = DEIN_ROUTER_BENUTZER
# Passwort für das Web-Interface
password = DEIN_ROUTER_PASSWORT
# normalerweise wird zuerst die API genutzt, falls das fehlschlägt wird Playwright verwendet
force_scraping = False # True => Playwright GUI Scraping statt API verwenden
# Die DSL-Fehlerzähler (UCRC/DCRC) liefert nur die Weboberfläche, nicht die API/JSON-Seite.
# gui = diese zwei Werte per kurzem Browser-Zugriff nachlesen (Standard)
# aus = nicht nachlesen; --update/--gui laufen dann komplett ohne Browser (Zähler bleiben 0)
crc_source = gui
# Die Firmware ab 09/2026 füllt DSL-/Client-Tabellen erst, wenn die Weboberfläche sie
# angefragt hat (die JSON-/API-Seite liefert sonst dauerhaft leer).
# auto = nur bei leeren Daten einmal die Weboberfläche besuchen (Standard)
# aus  = nie aufwecken
warmup = auto

[Email]
# Postausgangsserver (SMTP) für den Report-Versand
smtp_server = mail.dein-provider.de
smtp_port = 587

# Absenderadresse
sender_email = absender@example.com
# Passwort für das E-Mail-Postfach
sender_password = DEIN_EMAIL_PASSWORT

# Empfängeradresse des Berichts
recipient_email = empfaenger@example.com

[Analyse]
# Steuert welche Verbindungsabbrüche im Statusreport angezeigt werden.
# 0 = Alles (inkl. manuelle Resets, Router-Zeitplan und reguläre ISP-Zwangstrennungen)
# 1 = Nur echte Fehler und ungeplante Trennungen
# 2 = Nur Verbindungsabbrüche, die zu Problemen oder Leistungseinbußen geführt haben
# 3 = Nur schwerwiegende Störungen (physikalische Leitungsprobleme, Timeouts)
report_disconnects_level = 1

[Events]
# Filter: Welche Ereignistypen sollen beim Cleanup gelöscht werden
exclude_types = DHCPD, Mesh
# Anzahl der Tage, nach denen unwichtige Events gelöscht werden (0 = deaktiviert)
cleanup_excludes = 3

# Log Level Filter: 0 Notfall   1 Alarm    2 Kritisch  3 Fehler 
#                   4 Vorsicht  5 Hinweis  6 Info      7 Debug (zeigt alles)
#                   9 wie 7 Debug aber filtert 'exclude_types' aus
show_level = 4

[Charts]
# Chart-Konfigurationen für Statusreport (später GUI)
table_1 = dsl
field_1 = downstream_noise_margin # Hier können beliebige Werte aus der dsl Tabelle eingetragen werden
label_1 = Downstream Störabstand (dB) # Angezeigte Überschrift

# Zeitfenster
hours_back = 48 # Darstellungszeitraum in Stunden
start_hour = 0 # Chart beginnt um 00:00 Uhr

[Reports]
cleanup_reports = 7 # Reports älter als x Tage löschen

[Statistics]
# Diese Werte auf False setzen, um keine Auswertung zu erhalten
reconnects = True # Zeigt die Anzahl der Routereinwahlen
PADO_timeouts = True # Zeigt die Anzahl der PADO-Timeouts

[AI] # AI = Modul aktiviert, noAI = Modul deaktiviert

